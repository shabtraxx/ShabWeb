---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES, PROCESS } from '../data/services';
import { CONTACT, bookingHref, isSet } from '../config';

const title = 'Shab — Digital, Data and Cyber consulting';
const description =
  'Independent consultancy for organisations that have outgrown their systems and are carrying more risk than they can see. Digital, data and cyber, run by the people who do the work.';
---

<Base title={title} description={description}>
  <!-- Hero ------------------------------------------------------------- -->
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Independent consultancy</p>
        <h1>Decisions your board can stand behind.</h1>
        <p class="hero__lead">
          Shab works with organisations that have outgrown their systems and are carrying more risk
          than they can see. Three practices — digital, data and cyber — run by the people who do
          the work.
        </p>
        <div class="hero__actions">
          <a class="button" href={bookingHref()}>Book a 30-minute call</a>
          <p class="hero__aside">No pitch deck. We'll tell you if we're not the right fit.</p>
        </div>
      </div>

      <div class="hero__mark" aria-hidden="true">
        <svg viewBox="0 0 380 380" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="0.5" y="0.5" width="379" height="379" stroke="rgba(255,255,255,0.07)"></rect>
          <path d="M0 95H380M0 190H380M0 285H380M95 0V380M190 0V380M285 0V380" stroke="rgba(255,255,255,0.045)"></path>
          <path d="M190 46L306 96V196C306 262 254 316 190 336C126 316 74 262 74 196V96L190 46Z" stroke="rgba(255,255,255,0.18)" stroke-width="1.25"></path>
          <path class="hero__shield" d="M190 96L258 125V193C258 234 228 267 190 281C152 267 122 234 122 193V125L190 96Z" stroke="#3fd0d4" stroke-width="1.5"></path>
          <path class="hero__tick" d="M158 190L182 214L226 166" stroke="#3fd0d4" stroke-width="2" stroke-linecap="square"></path>
          <circle cx="190" cy="46" r="3.5" fill="#3fd0d4"></circle>
          <circle cx="306" cy="96" r="3.5" fill="rgba(255,255,255,0.35)"></circle>
          <circle cx="74" cy="96" r="3.5" fill="rgba(255,255,255,0.35)"></circle>
        </svg>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Trust ------------------------------------------------------------ -->
  <section class="trust" aria-label="Clients">
    <div class="container trust__inner">
      <p class="eyebrow eyebrow--plain">Trusted by teams at</p>
      <ul class="trust__logos">
        {Array.from({ length: 5 }).map(() => (
          <li class="trust__slot">[CLIENT LOGO]</li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- Services --------------------------------------------------------- -->
  <section class="section" id="services" aria-labelledby="services-heading">
    <div class="container services">
      <div class="services__head">
        <div class="services__intro">
          <p class="eyebrow">Three practices</p>
          <h2 id="services-heading">Most problems sit between them. So do we.</h2>
        </div>
        <p class="services__note">
          A failed migration is rarely just a technology problem, and a breach is rarely just a
          security one. We take the whole picture.
        </p>
      </div>

      <ul class="services__grid">
        {SERVICES.map((service) => (
          <li>
            <ServiceCard
              name={service.name}
              promise={service.promise}
              covers={service.covers}
              bestFor={service.bestFor}
              icon={service.icon}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- How we work ------------------------------------------------------ -->
  <section class="section" id="how-we-work" aria-labelledby="process-heading">
    <div class="container process">
      <div class="process__intro">
        <p class="eyebrow">How we work</p>
        <h2 id="process-heading">Short engagements. Clear handover.</h2>
        <p class="process__note">
          We are not trying to live in your organisation. The aim is for your own people to carry
          the work after we leave.
        </p>
      </div>

      <ol class="process__steps">
        {PROCESS.map((step, index) => (
          <li class="process__step">
            <span class="process__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="process__body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="rule" />

  <!-- Proof ------------------------------------------------------------ -->
  <section class="section proof" aria-label="Client feedback">
    <div class="container proof__inner">
      <span class="proof__mark" aria-hidden="true"></span>
      <blockquote class="proof__quote">
        <p class="placeholder">
          [TESTIMONIAL — one or two sentences from a client, in their own words, about what changed
          after the engagement.]
        </p>
      </blockquote>
      <figcaption class="proof__attribution">
        <span class="proof__name placeholder">[CLIENT NAME]</span>
        <span class="proof__role placeholder">[ROLE], [COMPANY]</span>
      </figcaption>
    </div>
  </section>

  <!-- Closing CTA ------------------------------------------------------ -->
  <section class="cta" id="contact" aria-labelledby="cta-heading">
    <div class="container cta__inner">
      <div class="cta__copy">
        <h2 id="cta-heading">Tell us what is keeping you up.</h2>
        <p>
          Thirty minutes, no charge. If it is not something we should take on, we will say so and
          point you somewhere better.
        </p>
      </div>
      <div class="cta__actions">
        <a class="button" href={bookingHref()}>Book a 30-minute call</a>
        <ul class="cta__contact">
          <li>
            {isSet(CONTACT.email)
              ? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              : <span class="placeholder">{CONTACT.email}</span>}
          </li>
          <li>
            {isSet(CONTACT.phone)
              ? <a href={`tel:${CONTACT.phone.replace(/\s+/g, '')}`}>{CONTACT.phone}</a>
              : <span class="placeholder">{CONTACT.phone}</span>}
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ---------------------------------------------------------------- */
  .hero__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 2rem;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .hero h1 {
    font-size: var(--step-hero);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--text-bright);
  }

  .hero__lead {
    max-width: 33ch;
    font-size: var(--step-lead);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 0.5rem;
  }

  .hero__aside {
    font-size: var(--step-small);
    color: var(--text-dim);
  }

  .hero__mark {
    justify-self: end;
    width: min(380px, 100%);
    line-height: 0;
  }

  .hero__shield,
  .hero__tick {
    animation: draw 900ms ease-out both;
    stroke-dasharray: 700;
    stroke-dashoffset: 0;
  }

  .hero__tick {
    animation-delay: 320ms;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 700;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__shield,
    .hero__tick {
      animation: none;
    }
  }

  /* Trust --------------------------------------------------------------- */
  .trust__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-block: 2.75rem;
  }

  .trust__logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .trust__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px dashed var(--rule-dashed);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  /* Services ------------------------------------------------------------ */
  .services {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .services__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
  }

  .services__intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 620px;
  }

  .services__intro h2,
  .process h2 {
    font-size: var(--step-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .services__note {
    max-width: 340px;
    font-size: var(--step-body);
    line-height: 1.7;
    color: var(--text-dim);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .services__grid > li {
    display: flex;
  }

  .services__grid > li > :global(*) {
    width: 100%;
  }

  /* Process ------------------------------------------------------------- */
  .process {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 2rem;
  }

  .process__intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .process__note {
    font-size: var(--step-body);
    line-height: 1.7;
    color: var(--text-dim);
  }

  .process__step {
    display: flex;
    gap: 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .process__step:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .process__number {
    min-width: 32px;
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--accent);
  }

  .process__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .process__body h3 {
    font-size: 1.25rem;
  }

  .process__body p {
    font-size: var(--step-body);
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Proof --------------------------------------------------------------- */
  .proof__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.25rem;
  }

  .proof__mark {
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .proof__quote {
    margin: 0;
    max-width: 880px;
  }

  .proof__quote p {
    font-family: var(--font-display);
    font-size: var(--step-quote);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .proof__attribution {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step-small);
  }

  .proof__name {
    font-weight: 500;
  }

  /* CTA ----------------------------------------------------------------- */
  .cta {
    background: var(--panel);
    border-top: 1px solid var(--rule);
  }

  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    padding-block: clamp(3rem, 2rem + 4.4vw, 5.5rem);
  }

  .cta__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 560px;
  }

  .cta__copy h2 {
    font-size: var(--step-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta__copy p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .cta__contact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: var(--step-small);
    color: var(--text-body);
  }

  .cta__contact a {
    color: var(--text-body);
  }

  /* Breakpoints --------------------------------------------------------- */
  @media (max-width: 980px) {
    .hero__grid,
    .process {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero__mark {
      justify-self: start;
      width: min(300px, 70%);
    }

    .hero__lead {
      max-width: 52ch;
    }

    .services__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .services__note {
      max-width: 52ch;
    }

    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cta__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .trust__logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .process__step {
      gap: 1.25rem;
    }

    .hero__actions .button {
      width: 100%;
    }
  }
</style>
