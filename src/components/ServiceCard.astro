---
interface Props {
  name: string;
  promise: string;
  covers: readonly string[];
  bestFor: string;
  icon: 'digital' | 'data' | 'cyber';
}

const { name, promise, covers, bestFor, icon } = Astro.props;
const headingId = `service-${name.toLowerCase()}`;
---

<article class="card" aria-labelledby={headingId}>
  <span class="card__icon" aria-hidden="true">
    {icon === 'digital' && (
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square">
        <rect x="2.5" y="4" width="19" height="13" rx="1"></rect>
        <path d="M8 21h8M12 17v4M6 8h6M6 11.5h9"></path>
      </svg>
    )}
    {icon === 'data' && (
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square">
        <ellipse cx="12" cy="5.5" rx="7.5" ry="3"></ellipse>
        <path d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13"></path>
        <path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"></path>
      </svg>
    )}
    {icon === 'cyber' && (
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square">
        <path d="M12 2.5l8 3.5v6c0 4.6-3.4 8.4-8 9.5-4.6-1.1-8-4.9-8-9.5v-6l8-3.5z"></path>
        <path d="M9 12l2 2 4-4"></path>
      </svg>
    )}
  </span>

  <div class="card__head">
    <h3 id={headingId}>{name}</h3>
    <p class="card__promise">{promise}</p>
  </div>

  <hr class="card__rule" />

  <ul class="card__covers">
    {covers.map((item) => <li>{item}</li>)}
  </ul>

  <div class="card__best">
    <span class="card__best-label">Best for</span>
    <p>{bestFor}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
    background: var(--panel);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
  }

  .card__icon {
    color: var(--accent);
    line-height: 0;
  }

  .card__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card__head h3 {
    font-size: var(--step-h3);
    letter-spacing: -0.01em;
  }

  .card__promise {
    font-size: var(--step-body);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .card__rule {
    border: 0;
    height: 1px;
    margin: 0;
    background: var(--rule-soft);
  }

  .card__covers {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--text-body);
  }

  .card__best {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .card__best-label {
    font-size: var(--step-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .card__best p {
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--text-dim);
  }
</style>
