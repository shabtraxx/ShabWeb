---
/**
 * Sector icons. Same 24px drawing grid, square caps and no fill as the
 * service icons. Sized to the average sector label width (labels measure
 * 96-127px), so the icon sits about as close to its label as one uniform
 * size can. The declared stroke is 0.5 because the 24 viewBox scales it up
 * ~4.3x here — that lands near the hero mark's hairline weight rather than
 * the slab a 1.2 stroke would become at this size.
 */
interface Props {
  icon: 'government' | 'construction' | 'manufacturing' | 'realestate';
}

const { icon } = Astro.props;
---

<svg
  width="104"
  height="104"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="0.5"
  stroke-linecap="square"
  aria-hidden="true"
>
  {icon === 'government' && (
    <g>
      <path d="M3.5 21h17"></path>
      <path d="M4.5 8.5L12 3.5l7.5 5"></path>
      <path d="M4.5 8.5h15"></path>
      <path d="M7.5 8.5v9M12 8.5v9M16.5 8.5v9"></path>
    </g>
  )}
  {icon === 'construction' && (
    <g>
      <path d="M2.5 19.5h19"></path>
      <path d="M5 19.5v-3a7 7 0 0114 0v3"></path>
      <path d="M9.5 10.2v6.3M14.5 10.2v6.3"></path>
      <path d="M12 9.5V7"></path>
    </g>
  )}
  {icon === 'manufacturing' && (
    <g>
      <path d="M2.5 20.5h19"></path>
      <path d="M3.5 20.5V9.5l5 3.5v-3.5l5 3.5v-3.5l5 3.5v11"></path>
      <path d="M15.5 12V4.5h3V14"></path>
    </g>
  )}
  {icon === 'realestate' && (
    <g>
      <path d="M3 10l9-6.5 9 6.5"></path>
      <path d="M5.5 8.5V21M18.5 8.5V21"></path>
      <path d="M3.5 21h17"></path>
      <path d="M9.5 21v-6h5v6"></path>
    </g>
  )}
</svg>
