---
/**
 * Sector icons. Same drawing rules as the service icons: 24px grid,
 * 1.4 stroke, square caps, no fill — so they sit together as one set.
 */
interface Props {
  icon: 'government' | 'construction' | 'manufacturing' | 'realestate';
}

const { icon } = Astro.props;
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="square"
  aria-hidden="true"
>
  {icon === 'government' && (
    <g>
      <path d="M3.5 21h17"></path>
      <path d="M4.5 8.5L12 3.5l7.5 5"></path>
      <path d="M4.5 8.5h15"></path>
      <path d="M7.5 8.5v9M12 8.5v9M16.5 8.5v9"></path>
    </g>
  )}
  {icon === 'construction' && (
    <g>
      <path d="M2.5 19.5h19"></path>
      <path d="M5 19.5v-3a7 7 0 0114 0v3"></path>
      <path d="M9.5 10.2v6.3M14.5 10.2v6.3"></path>
      <path d="M12 9.5V7"></path>
    </g>
  )}
  {icon === 'manufacturing' && (
    <g>
      <path d="M2.5 20.5h19"></path>
      <path d="M3.5 20.5V9.5l5 3.5v-3.5l5 3.5v-3.5l5 3.5v11"></path>
      <path d="M15.5 12V4.5h3V14"></path>
    </g>
  )}
  {icon === 'realestate' && (
    <g>
      <path d="M3 10l9-6.5 9 6.5"></path>
      <path d="M5.5 8.5V21M18.5 8.5V21"></path>
      <path d="M3.5 21h17"></path>
      <path d="M9.5 21v-6h5v6"></path>
    </g>
  )}
</svg>
